    {"id":"no-agent-config-tamper","d":"Changing the Claude Code or Hermes config from a shell (the file tools are already blocked)","t":"command","p":"(?:>>?|\\btee\\b|\\bsed\\s+-i|\\brm\\b|\\bdel\\b|\\berase\\b|\\btruncate\\b|\\bset-content\\b|\\bout-file\\b|\\badd-content\\b|\\bremove-item\\b|\\bclear-content\\b|\\bdd\\b|\\bperl\\s+-[a-z]*i|\\bchmod\\b|\\bchown\\b|\\btouch\\b|\\bsponge\\b)[^\\n]*(?:\\.claude[\\/\\\\]settings(?:\\.local)?\\.json|(?:\\.hermes|\\bhermes)[\\/\\\\]config\\.yaml)|\\b(?:cp|copy(?:-item)?|mv|move(?:-item)?|ren(?:ame)?(?:-item)?|install|ln|mklink|rsync)\\b[^\\n]*(?:\\.claude[\\/\\\\]settings(?:\\.local)?\\.json|(?:\\.hermes|\\bhermes)[\\/\\\\]config\\.yaml)[\"']?\\s*(?:$|[;&|])","l":1,"o":"platform","os":"linux"},
    {"id":"linux-mkfs","d":"Creating filesystems or wiping signatures","t":"command","p":"\\b(mkfs(\\.\\w+)?|wipefs|mkswap)\\b","o":"platform","os":"linux"},
    {"id":"linux-dd-device","d":"dd writing to a device","t":"command","p":"\\bdd\\b[^;&|\\n]*\\bof=/dev/(?!null\\b|zero\\b|stdout\\b|stderr\\b|tty)","o":"platform","os":"linux"},
    {"id":"linux-write-device","d":"Redirecting output onto a block device","t":"command","p":">\\s*/dev/(sd|nvme|hd|vd|xvd|mmcblk)\\w*","o":"platform","os":"linux"},
    {"id":"linux-shred-device","d":"shred on a device","t":"command","p":"\\bshred\\b[^;&|\\n]*\\s/dev/","o":"platform","os":"linux"},
    {"id":"linux-fork-bomb","d":"Fork bomb","t":"command","p":":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&\\s*\\}\\s*;\\s*:","o":"platform","os":"linux"},
    {"id":"rm-long-flags","d":"rm with separate or long recursive+force flags","t":"command","p":"\\brm\\b(?=[^;&|\\n]*(\\s-[a-z]*r[a-z]*\\b|--recursive))(?=[^;&|\\n]*(\\s-[a-z]*f[a-z]*\\b|--force))","o":"platform","os":"linux"},
    {"id":"no-preserve-root","d":"rm --no-preserve-root","t":"command","p":"--no-preserve-root","o":"platform","os":"linux"},
    {"id":"pipe-to-shell","d":"Piping a download straight into a shell","t":"command","p":"\\b(curl|wget)\\b[^|\\n]*\\|\\s*(sudo\\s+)?(ba|z|da|k)?sh\\b","o":"platform","os":"linux"},
    {"id":"find-delete","d":"find -delete (recursive delete without rm)","t":"command","p":"\\bfind\\b[^;&|\\n]*\\s-delete\\b","o":"platform","os":"linux"},
    {"id":"find-exec-rm","d":"find -exec/-execdir rm (recursive delete without rm -rf)","t":"command","p":"\\bfind\\b[^;&|\\n]*\\s-(exec|execdir|ok|okdir)\\s+(\\S*\\/)?rm\\b","o":"platform","os":"linux"},
    {"id":"chmod-chown-system","d":"Recursive chmod/chown on / or a system directory","t":"command","p":"\\b(chmod|chown)\\s+(-[a-z]*R[a-z]*|--recursive)\\b[^;&|\\n]*\\s(/|/etc|/usr|/var|/bin|/sbin|/boot|/lib|/opt|/home|~)/?(\\s|$|[;&|])","o":"platform","os":"linux"}
  ],
  "examples": {
