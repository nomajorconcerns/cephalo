{
  "defaults": [
    {"id":"no-drop","d":"Dropping tables or databases","t":"command","p":"\\bDROP\\s+(TABLE|DATABASE|SCHEMA)\\b","o":"default"},
    {"id":"no-truncate","d":"Truncating tables","t":"command","p":"\\bTRUNCATE\\s+(TABLE\\s+)?[\\w.\"]+","o":"default"},
    {"id":"no-delete-all","d":"DELETE FROM with no WHERE clause","t":"command","p":"\\bDELETE\\s+FROM\\s+[\\w.\"]+\\s*(;|\"|$)","o":"default"},
    {"id":"no-rm-rf","d":"Recursive forced rm","t":"command","p":"\\brm\\s+-(?=[a-z]*r)(?=[a-z]*f)[a-z]+","o":"default"},
    {"id":"no-win-recursive-delete","d":"Recursive delete on Windows","t":"command","p":"(Remove-Item\\b(?=.*-Recurse)(?=.*-Force))|(\\b(rd|rmdir)\\s+\\/s\\b)|(\\bdel\\s+.*\\/s\\b)","o":"default"},
    {"id":"no-force-push","d":"Force pushing to git remotes","t":"command","p":"\\bgit\\s+push\\b(?=.*(\\s--force(?!-with-lease)\\b|\\s-f\\b))","o":"default"},
    {"id":"no-force-push-refspec","d":"Force pushing with a + refspec (git push origin +main)","t":"command","p":"\\bgit(\\s+-[cC]\\s+\\S+)*\\s+push\\b[^;&|\\n]*\\s[\"']?\\+[^\\s;&|]","o":"default"},
    {"id":"no-pipe-to-shell","d":"Piping output into a shell, eval of a substitution, or running a substitution as a script (ask the user to run installers)","t":"command","p":"\\|&?\\s*(sudo\\s+(-\\S+\\s+)*)?(env\\s+)?(\\/(usr\\/)?bin\\/)?(ba|z|da|k)?sh(?=[\\s;&|)]|$)|\\beval\\s+[\"']?(\\$\\(|`)|\\b(ba|z|da|k)?sh\\s+(-\\S+\\s+)*<\\(|\\b(ba|z|da|k)?sh\\s+-c\\s+[\"']?\\$\\(|\\bsource\\s+<\\(","o":"default"},
    {"id":"no-hard-reset","d":"git reset --hard","t":"command","p":"\\bgit\\s+reset\\s+--hard\\b","o":"default"},
    {"id":"no-secret-read","d":"Reading .env secret files via shell","t":"command","p":"\\b(cat|type|Get-Content|gc|more|less|head|tail)\\b.*\\.env\\b(?!\\.example)","o":"default"},
    {"id":"no-secret-file","d":"Accessing .env secret files","t":"path","on":"any","p":"(^|[\\/\\\\])\\.env(\\.(?!example$)[\\w.-]+)?$","o":"default"},
    {"id":"protect-config","d":"Writing Claude Code or Hermes config","t":"path","on":"write","p":"[\\/\\\\]\\.claude[\\/\\\\]settings(\\.local)?\\.json$|[\\/\\\\]hermes[\\/\\\\]config\\.yaml$","o":"default"}
  ],
  "win32": [
    {"id":"protect-cephalo-policy","d":"Writing Cephalo's settings (config.yml), the Pro license and egress allowlist, the Pro package, MCP allowlist, tool approvals, tripwire state, integrity markers or local-model settings","t":"path","on":"write","p":"[\\/\\\\]\\.cephalo[\\/\\\\](mcp[^\\/\\\\]*$|models\\.yml[^\\/\\\\]*$|sync\\.yml[^\\/\\\\]*$|prices\\.yml[^\\/\\\\]*$|config\\.yml[^\\/\\\\]*$|license\\.json[^\\/\\\\]*$|egress\\.yml[^\\/\\\\]*$|pro([\\/\\\\]|$)|integrity([\\/\\\\]|$)|(judge|embed)-cache\\.json$|models-check\\.json$|asks([\\/\\\\]|$)|tripwire([\\/\\\\.]|$))","l":1,"o":"platform","os":"win32"},
    {"id":"protect-audit-log","d":"Writing Cephalo's audit log or rules file (the record of what the agent did, and the limits on it)","t":"path","on":"write","p":"[\\/\\\\]\\.cephalo[\\/\\\\](audit\\.jsonl(\\.head)?|rules\\.yml)(\\.cephalo-backup-[\\w.-]+)?$","l":1,"o":"platform","os":"win32"},
    {"id":"no-audit-tamper","d":"Changing or deleting Cephalo's audit log, rules file or settings (config.yml) from a shell","t":"command","p":"(>>?|\\btee\\b|\\bsed\\s+-i|\\brm\\b|\\bdel\\b|\\berase\\b|\\bmv\\b|\\bmove(-item)?\\b|\\bcp\\b|\\bcopy(-item)?\\b|\\btruncate\\b|\\bset-content\\b|\\bout-file\\b|\\badd-content\\b|\\bremove-item\\b|\\bclear-content\\b|\\bren(ame)?(-item)?\\b|\\bdd\\b)[^\\n]*\\.cephalo[\\/\\\\](audit\\.jsonl|rules\\.yml|config\\.yml|license\\.json|egress\\.yml|pro(?![w.-]))","l":1,"o":"platform","os":"win32"},
    {"id":"protect-vault-files","d":"Reading or writing Cephalo's secrets vault files","t":"path","on":"any","p":"[\\/\\\\]\\.cephalo[\\/\\\\]vault[^\\/\\\\]*$","l":1,"o":"platform","os":"win32"},
    {"id":"protect-policy-key","d":"Reading or writing the key that signs shared policy (cephalo sync keygen)","t":"path","on":"any","p":"[\\/\\\\]\\.cephalo[\\/\\\\]policy-(signing\\.key|trusted\\.pub)[^\\/\\\\]*$","l":1,"o":"platform","os":"win32"},
    {"id":"no-vault-extract","d":"Changing or reading the secrets vault outside `cephalo run` (vault set/allow/remove/reveal, OS key APIs, the vault files)","t":"command","p":"(\\bcephalo(\\.cmd|\\.ps1)?|cli\\.js[\"']?)\\s+vault\\s+(set|allow|remove|rm|reveal)\\b|\\.cephalo[\\/\\\\]vault|\\.cephalo[\\/\\\\]policy-signing\\.key|\\b(ProtectedData|Unprotect)\\b|\\bsecret-tool\\s+(lookup|search|clear)\\b","l":1,"o":"platform","os":"win32"},
    {"id":"secret-in-command","d":"A literal API token in a command. Store it with `cephalo vault set NAME` (the user does this) and run with `cephalo run --env NAME -- ...`","t":"command","p":"(?:\\bgh[pousr]_[A-Za-z0-9]{36,}\\b)|(?:\\bgithub_pat_[A-Za-z0-9_]{50,}\\b)|(?:\\bsk-ant-[A-Za-z0-9_-]{30,})|(?:\\bsk-(?:proj-)?[A-Za-z0-9_-]{32,})|(?:\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b)|(?:\\bxox[baprs]-[A-Za-z0-9-]{10,})|(?:\\bAIza[0-9A-Za-z_-]{35}\\b)|(?:\\bglpat-[A-Za-z0-9_-]{20,})|(?:\\bnpm_[A-Za-z0-9]{36}\\b)|(?:\\b[rs]k_live_[A-Za-z0-9]{24,})|(?:-----BEGIN [A-Z ]*PRIVATE KEY-----)|(?:\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})","l":1,"o":"platform","os":"win32"},
    {"id":"no-self-approve","d":"An agent approving MCP servers, releasing the tripwire, changing Cephalo's settings or rules, the egress allowlist, the Pro license or Cephalo's own version, itself","t":"command","p":"(\\bcephalo(\\.cmd|\\.ps1)?|cli\\.js[\"']?)\\s+(mcp\\s+(allow|approve|pin|mode|trust)|tripwire\\s+(clear|mode|reset|allow)|config\\s+set|rules\\s+reset|egress\\s+(allow|remove|mode)|pro\\s+(activate|renew|install|deactivate)|update)\\b","l":1,"o":"platform","os":"win32"},
    {"id":"no-self-incident","d":"An agent adding or removing its own learned rules","t":"command","p":"(\\bcephalo(\\.cmd|\\.ps1)?|cli\\.js[\"']?)\\s+incident\\b[^\\n]*(--use|\\bundo\\b)","l":1,"o":"platform","os":"win32"},
    {"id":"no-secret-shell","d":"A shell command that names a .env secret file (cat, grep, awk, cp, source, ... .env). .env.example is fine","t":"command","p":"(?:^|[\\s'\"=:/\\\\<>(,])\\.env(?:\\.(?!(?:example|sample|template)\\b)[\\w.-]+)?(?=$|[\\s'\";&|)<>,])","l":1,"o":"platform","os":"win32"},
    {"id":"no-agent-config-tamper","d":"Changing the Claude Code or Hermes config from a shell (the file tools are already blocked)","t":"command","p":"(?:>>?|\\btee\\b|\\bsed\\s+-i|\\brm\\b|\\bdel\\b|\\berase\\b|\\btruncate\\b|\\bset-content\\b|\\bout-file\\b|\\badd-content\\b|\\bremove-item\\b|\\bclear-content\\b|\\bdd\\b|\\bperl\\s+-[a-z]*i|\\bchmod\\b|\\bchown\\b|\\btouch\\b|\\bsponge\\b)[^\\n]*(?:\\.claude[\\/\\\\]settings(?:\\.local)?\\.json|(?:\\.hermes|\\bhermes)[\\/\\\\]config\\.yaml)|\\b(?:cp|copy(?:-item)?|mv|move(?:-item)?|ren(?:ame)?(?:-item)?|install|ln|mklink|rsync)\\b[^\\n]*(?:\\.claude[\\/\\\\]settings(?:\\.local)?\\.json|(?:\\.hermes|\\bhermes)[\\/\\\\]config\\.yaml)[\"']?\\s*(?:$|[;&|])","l":1,"o":"platform","os":"win32"},
    {"id":"rm-long-flags","d":"rm with separate or long recursive+force flags","t":"command","p":"\\brm\\b(?=[^;&|\\n]*(\\s-[a-z]*r[a-z]*\\b|--recursive))(?=[^;&|\\n]*(\\s-[a-z]*f[a-z]*\\b|--force))","o":"platform","os":"win32"},
    {"id":"no-preserve-root","d":"rm --no-preserve-root","t":"command","p":"--no-preserve-root","o":"platform","os":"win32"},
    {"id":"find-delete","d":"find -delete (recursive delete without rm)","t":"command","p":"\\bfind\\b[^;&|\\n]*\\s-delete\\b","o":"platform","os":"win32"},
    {"id":"find-exec-rm","d":"find -exec/-execdir rm (recursive delete without rm -rf)","t":"command","p":"\\bfind\\b[^;&|\\n]*\\s-(exec|execdir|ok|okdir)\\s+(\\S*\\/)?rm\\b","o":"platform","os":"win32"},
    {"id":"win-format-drive","d":"Formatting a drive (format X:)","t":"command","p":"\\bformat(\\.com)?\\s+[a-z]:(?![\\w\\\\/])","o":"platform","os":"win32"},
    {"id":"win-disk-wipe","d":"Disk partitioning or wiping tools","t":"command","p":"\\b(diskpart|Clear-Disk|Remove-Partition|Format-Volume|Initialize-Disk)\\b","o":"platform","os":"win32"},
    {"id":"win-registry-delete","d":"Deleting registry keys or values","t":"command","p":"\\breg(\\.exe)?\\s+delete\\b|Remove-Item(Property)?\\b[^;&|\\n]*\\bHK(LM|CU|CR|U):","o":"platform","os":"win32"},
    {"id":"win-shadow-delete","d":"Deleting shadow copies or boot entries","t":"command","p":"\\bvssadmin(\\.exe)?\\s+delete\\b|\\bwmic\\b[^;&|\\n]*\\bshadowcopy\\s+delete\\b|\\bbcdedit(\\.exe)?\\s+/delete\\b","o":"platform","os":"win32"},
    {"id":"win-power","d":"Shutting down or restarting the machine","t":"command","p":"\\bshutdown(\\.exe)?\\s+/[srp]\\b|\\b(Stop|Restart)-Computer\\b","o":"platform","os":"win32"}
  ],
