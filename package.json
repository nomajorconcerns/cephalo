{
  "name": "@nomajorconcerns/cephalo",
  "version": "0.3.0",
  "description": "Guards AI coding agents by blocking dangerous tool calls before they run",
  "type": "module",
  "license": "MIT",
  "author": "nomajorconcerns",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nomajorconcerns/cephalo.git"
  },
  "homepage": "https://github.com/nomajorconcerns/cephalo#readme",
  "bugs": {
    "url": "https://github.com/nomajorconcerns/cephalo/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "hermes-agent",
    "mcp",
    "security",
    "guardrails",
    "firewall"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cephalo": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/tests",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/make-integrity.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:release": "node --test scripts/release.test.mjs scripts/workflow.test.mjs scripts/stats.test.mjs scripts/site-rules.test.mjs scripts/checkout.test.mjs scripts/release-page.test.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack",
    "prepublishOnly": "npm run build && node scripts/release.mjs check --quick"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
