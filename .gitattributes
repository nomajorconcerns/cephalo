# site/rules.json is generated by scripts/site-rules.mjs and checked byte for byte against the built CLI
# (scripts/site-rules.test.mjs), so it keeps LF line endings on every checkout, including Windows with core.autocrlf.
site/rules.json text eol=lf
# Google Search Console's verification file must stay exactly as Google issued it (one line, LF).
site/google*.html text eol=lf
